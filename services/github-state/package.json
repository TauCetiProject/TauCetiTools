{
  "name": "tauceti-github-state",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "npm run typecheck && npm run build && node --test tests/*.test.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "drill": "node scripts/outage-drill.mjs",
    "test:postgres": "npm run typecheck && npm run build && node scripts/test-postgres.mjs",
    "benchmark:postgres": "node scripts/benchmark-postgres.mjs",
    "test:publication-memory": "node --max-old-space-size=96 tests/publication_memory.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "esbuild": "0.28.2",
    "miniflare": "latest",
    "typescript": "^5.9.3",
    "wrangler": "4.149.0",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0"
  }
}
